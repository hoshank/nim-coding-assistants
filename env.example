# ==============================================================================
# NVIDIA NIM Assistant Bridge Configuration
# ==============================================================================

# Your NVIDIA API Key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA Base Endpoint (Default is NVIDIA Cloud API Catalog)
# For self-hosted local NIM, you can set: http://localhost:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Default Coding Model for Claude Code, Codex CLI, and Zed
# Current active supported models:
# - nvidia/nemotron-3-ultra-550b-a55b  (Default - Ultra 550B flagship)
# - nvidia/nemotron-3-super-120b-a12b  (Super 120B high-efficiency)
# - deepseek-ai/deepseek-v4-pro        (DeepSeek V4 Pro)
# - deepseek-ai/deepseek-v4-flash-0731 (DeepSeek V4 Flash fast completion)
# - minimaxai/minimax-m3               (MiniMax M3 with vision support)
# - z-ai/glm-5.2                       (GLM 5.2)
# - thinkingmachines/inkling           (Thinking Machines Inkling)
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Local proxy port for Claude Code Anthropic translation
NIM_PROXY_PORT=8000
