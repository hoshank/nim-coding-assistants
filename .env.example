# ==============================================================================
# NVIDIA NIM Assistant Bridge Configuration
# ==============================================================================

# Your NVIDIA API Key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA Base Endpoint (Default is NVIDIA Cloud API Catalog)
# For self-hosted local NIM, you can set: http://localhost:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Default Coding Model for Claude Code and Codex CLI
# Recommended choices:
# - meta/llama-3.3-70b-instruct      (Top general performance, tool-use supported)
# - nvidia/nemotron-3-super-120b-a12b(NVIDIA Nemotron Super)
# - qwen/qwen2.5-coder-32b-instruct  (Fast, strong coding performance)
# - mistralai/mistral-large-2-instruct
# - deepseek-ai/deepseek-r1
NIM_MODEL=meta/llama-3.3-70b-instruct

# Local proxy port for Claude Code Anthropic translation
NIM_PROXY_PORT=8000
